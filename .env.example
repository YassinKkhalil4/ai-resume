# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=

# Email verification
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@example.com

